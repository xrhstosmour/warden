# Managed by warden, local changes are overwritten on the next run.
#
# A record of who changed accounts, privileges, remote access, the firewall
# or the kernel. Search it with `ausearch -k <key>`.

-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/subuid -p wa -k identity
-w /etc/subgid -p wa -k identity

-w /etc/sudoers -p wa -k privilege
-w /etc/sudoers.d/ -p wa -k privilege
-w /usr/bin/sudo -p x -k privilege
-w /usr/bin/su -p x -k privilege

-w /etc/ssh/sshd_config -p wa -k remote-access
-w /etc/ssh/sshd_config.d/ -p wa -k remote-access

-w /etc/nftables.conf -p wa -k firewall
-w /etc/sysctl.conf -p wa -k kernel
-w /etc/sysctl.d/ -p wa -k kernel
-w /etc/modprobe.d/ -p wa -k kernel
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k kernel

-w /etc/systemd/system/ -p wa -k services
-w /etc/cron.d/ -p wa -k services
-w /var/spool/cron/ -p wa -k services
