# Copy to warden.conf and fill in. Sourced by bash as root, keep it yours.

# The account you log in with to administer the server. It gets sudo, which
# asks for a password you choose during the first run.
ADMIN_USER=admin

# The account deployments log in with. It runs the containers with rootless
# Docker and has no sudo.
DEPLOY_USER=deploy

# Leave both empty and provision.sh makes an ed25519 key pair per account in
# ~/.ssh on this machine, named after SERVER_HOSTNAME or the host. Or paste
# public keys you already have, a different one per account.
ADMIN_PUBLIC_KEY=""
DEPLOY_PUBLIC_KEY=""

# SSH moves here from 22. Allow it at the provider's firewall too if there
# is one.
SSH_PORT=2222

# public: SSH_PORT is open to everyone, or to SSH_SOURCES when set.
# tailscale: SSH_PORT answers on the tailnet only, nothing on the public
# address. Needs this machine on the same tailnet.
SSH_ACCESS=public

# Optional with SSH_ACCESS=public, only these addresses or ranges may reach
# SSH, separated by spaces. Empty means anywhere.
SSH_SOURCES=""

# Joins the server to your tailnet. A one-off key from
# https://login.tailscale.com/admin/settings/keys, only needed on the first
# run. Empty, the first run prints a login URL to approve in your browser
# instead. Empty and SSH_ACCESS=public leaves Tailscale out.
TAILSCALE_AUTH_KEY=""

# yes: Tailscale SSH on port 22 of the tailnet address too, signed in by the
# tailnet's access rules rather than keys. The SSH_PORT login stays as well.
TAILSCALE_SSH=no

# Ports open to everyone. UDP 443 is HTTP/3.
PUBLIC_TCP_PORTS="80 443"
PUBLIC_UDP_PORTS="443"

# Optional, a single label such as app-1. Empty keeps the provider's.
SERVER_HOSTNAME=""
TIMEZONE=UTC

# When the server may reboot itself after a kernel update, server time.
REBOOT_TIME="04:00"

# Swap file size when the server has no swap, 0 for none.
SWAP_SIZE=2G

# yes: keeps /etc in git with etckeeper and commits what warden changed, so
# every change is a diff you can read and undo. The history can hold old
# copies of anything that was ever in /etc, root alone can read it. no: off.
ETCKEEPER=yes

# yes: prints load, disk, failed units, a pending reboot and listening ports
# on every interactive SSH login. It only reads local state, nothing leaves
# the server. no: off.
LOGIN_STATUS=yes

# yes: installs warden-audit, run it as `sudo warden-audit` to check the server
# still matches what warden set up. It only reads, it changes nothing. no: off.
AUDIT_TOOL=yes
